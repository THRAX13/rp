# Copy to .env and export these (or pass them in Docker). All are optional.
PORT=3000
HOST=127.0.0.1
# Public URL users/senders reach this server at. Used to build ingest URLs.
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
# Allow additional people to create their own workspaces on the sign-in page (1/0).
ALLOW_SIGNUP=0
# Number of reverse proxies in front of the app (so client IPs are read from X-Forwarded-For).
TRUST_PROXY=0
# Optional: derive the at-rest encryption key from this value instead of data/secret.key.
# RELAYOPS_SECRET_KEY=change-me-to-a-long-random-string
# DEV ONLY — never enable on a public server (disables SSRF protections):
# ALLOW_PRIVATE_TARGETS=1
# ALLOW_HTTP_TARGETS=1
